{
  "name": "@dailybee/ui",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "DailyBee design-system primitives ported to TypeScript (tokens + React components). Source-consumed by Vite; no build step.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/styles.css",
    "./tokens/*": "./src/styles/tokens/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.42.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
