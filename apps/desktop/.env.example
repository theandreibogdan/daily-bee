# Copy to apps/desktop/.env (ignored by git). Read by electron-vite at build time; only VITE_* reaches the renderer.

# Address of DailyBee Cloud, the hosted workspace API (deploy/cloud/README.md). Empty or missing: the
# wizard shows the option as not available yet. For a local end-to-end test: http://127.0.0.1:8787
VITE_DAILYBEE_CLOUD_URL=
