# Port for the tRPC HTTP server (desktop app points at http://host:PORT)
PORT=8787

# Postgres connection. Leave unset to run the in-memory repository with the sample team
# (development only: any bearer token is accepted and everyone can see Team/Admin).
# DATABASE_URL=postgres://dailybee:dailybee@localhost:5432/dailybee

# `pnpm --filter @dailybee/api migrate` provisions an admin user with this token when set.
# SEED_TOKEN=change-me
# SEED_EMAIL=you@example.com
# SEED_NAME=Your Name
# SEED_TEAM=Platform
# SEED_WORKSPACE=ws_default
