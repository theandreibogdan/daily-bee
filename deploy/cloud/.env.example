# Copy to .env next to docker-compose.yml. The file is ignored by git.

# Postgres password for the "dailybee" user. Letters and digits only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Host port the API listens on (the container always uses 8787).
API_PORT=8787

# Host port of the desktop update feed (deploy/cloud/updates).
UPDATES_PORT=8788

# Only for the TLS profile (docker compose --profile tls): the DNS name pointing at this host.
CLOUD_DOMAIN=cloud-test.example.com
